# Auth0 config
# The tenant domain Auth0 (ej: https://dev-xxx.us.auth0.com)
AUTH0_DOMAIN=https://dummy.us.auth0.com/
# The audience from the API in Auth0 (Usually the API_URL)
AUTH0_AUDIENCE=http://localhost:8080

# Comma-separated origins allowed by the API CORS middleware.
# Required when using Swagger UI Try it out from http://localhost:8081.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Storage config.
# Local docker-compose uses MinIO through the S3-compatible adapter so browser uploads
# behave like production presigned uploads. Use `memory` only for narrow local backend
# experiments where no real browser/object-storage upload is required.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://minio.localhost:9000
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BUCKET=loresuelvo-public-local
STORAGE_PRIVATE_BUCKET=loresuelvo-private-local
STORAGE_PUBLIC_BASE_URL=http://minio.localhost:9000/loresuelvo-public-local
TEST_STORAGE_PUBLIC_BUCKET=loresuelvo-public-test
TEST_STORAGE_PRIVATE_BUCKET=loresuelvo-private-test
TEST_STORAGE_PUBLIC_BASE_URL=http://minio.localhost:9000/loresuelvo-public-test
STORAGE_ACCESS_KEY_ID=loresuelvo-local
STORAGE_SECRET_ACCESS_KEY=loresuelvo-local-secret
STORAGE_PRESIGN_EXPIRATION_SECONDS=600

# Set to true to apply idempotent provider/category seed data on API startup.
# Keep disabled unless the target environment should receive seed data.
SEEDS_ENABLED=true
SEEDS_FILE=seeds/providers-100.yaml
ENVIRONMENT=dev
# Use fake locally/E2E to avoid paid Gemini calls; switch to gemini with CHATBOT_API_KEY when testing the real provider.
CHATBOT_PROVIDER=fake
CHATBOT_MODEL=
CHATBOT_API_KEY=
