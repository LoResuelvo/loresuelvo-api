# Auth0 config
# The tenant domain Auth0 (ej: https://dev-xxx.us.auth0.com)
AUTH0_DOMAIN=https://dummy.us.auth0.com/
# The audience from the API in Auth0 (Usually the API_URL)
AUTH0_AUDIENCE=http://localhost:8080

# Comma-separated origins allowed by the API CORS middleware.
# Required when using Swagger UI Try it out from http://localhost:8081.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Storage config.
# Local docker-compose uses MinIO through the S3-compatible adapter so browser uploads
# behave like production presigned uploads. Use `memory` only for narrow local backend
# experiments where no real browser/object-storage upload is required.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://minio.localhost:9000
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BUCKET=loresuelvo-public-local
STORAGE_PRIVATE_BUCKET=loresuelvo-private-local
STORAGE_PUBLIC_BASE_URL=http://minio.localhost:9000/loresuelvo-public-local
TEST_STORAGE_PUBLIC_BUCKET=loresuelvo-public-test
TEST_STORAGE_PRIVATE_BUCKET=loresuelvo-private-test
TEST_STORAGE_PUBLIC_BASE_URL=http://minio.localhost:9000/loresuelvo-public-test
STORAGE_ACCESS_KEY_ID=loresuelvo-local
STORAGE_SECRET_ACCESS_KEY=loresuelvo-local-secret
STORAGE_PRESIGN_EXPIRATION_SECONDS=600

# Set to true to apply idempotent provider/category seed data on API startup.
# Keep disabled unless the target environment should receive seed data.
SEEDS_ENABLED=true
SEEDS_FILE=seeds/providers-100.yaml
ENVIRONMENT=dev
# Use fake locally/E2E to avoid paid Gemini calls; switch to gemini with CHATBOT_API_KEY when testing the real provider.
CHATBOT_PROVIDER=fake
CHATBOT_MODEL=
CHATBOT_API_KEY=

# Mercado Pago marketplace OAuth. The deployed, non-sensitive values for staging
# and production are versioned in config/staging.conf and config/prod.conf and loaded by the
# corresponding deployment workflows. The local defaults below remain local-only.
# The redirect URI must exactly match the URL
# registered in the Mercado Pago application. Use sandbox outside production;
# changing environments requires linking seller accounts again.
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:8080/oauth/payment-accounts/callback

# Active payment-account connector and provider-independent frontend callback.
PAYMENT_ACCOUNT_PROVIDER=mercado_pago
PAYMENT_ACCOUNT_CONNECTION_SUCCESS_URL=http://localhost:3000/provider/register/mercado-pago?result=success
PAYMENT_ACCOUNT_CONNECTION_CANCELLED_URL=http://localhost:3000/provider/register/mercado-pago?result=cancelled

# Checkout Pro browser return URLs and server-to-server notification URL.
# Mercado Pago requires public HTTPS URLs; use a tunnel or deployed environment
# rather than localhost when exercising the real integration.
PAYMENT_CHECKOUT_SUCCESS_URL=
PAYMENT_CHECKOUT_PENDING_URL=
PAYMENT_CHECKOUT_FAILURE_URL=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_WEBHOOK_SECRET=

# Application-level encryption for payment-account credentials.
# Generate a unique key per environment with: openssl rand -base64 32
PAYMENT_ACCOUNT_CREDENTIAL_ENCRYPTION_KEY=
