{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoResuelvo summarization case",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "holdout"
      ]
    },
    "origin": {
      "enum": [
        "synthetic_authored_case",
        "public_scenario_adaptation"
      ]
    },
    "execution_scope": {
      "enum": [
        "adapter"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "policy_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "label_basis": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "expert_validation": {
          "const": false
        },
        "created_on": {
          "type": "string",
          "format": "date"
        },
        "scenario_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scenario_basis": {
          "enum": [
            "authored_control",
            "public_question_adapted"
          ]
        },
        "adaptation_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "policy_ids",
        "source_ids",
        "label_basis",
        "rationale",
        "expert_validation",
        "created_on",
        "scenario_source_ids",
        "scenario_basis",
        "adaptation_notes"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^SM-[0-9]{3}$"
    },
    "task": {
      "const": "summarization"
    },
    "review_status": {
      "const": "approved"
    },
    "input": {
      "type": "object",
      "properties": {
        "previous_summary": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sender_role": {
                "enum": [
                  "consumer",
                  "assistant"
                ]
              },
              "content": {
                "type": "string"
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "file_id",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "sender_role",
              "content",
              "images"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "previous_summary",
        "messages"
      ],
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "facts_to_preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "must_not_invent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "semantic_assertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "required_image_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reference",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "facts_to_preserve",
        "must_not_invent",
        "semantic_assertions",
        "required_image_refs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "title",
    "group",
    "family_id",
    "split",
    "origin",
    "execution_scope",
    "provenance",
    "id",
    "task",
    "review_status",
    "input",
    "expected"
  ],
  "additionalProperties": false
}
