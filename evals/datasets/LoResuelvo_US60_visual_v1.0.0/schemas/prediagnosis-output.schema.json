{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw prediagnosis response (canonical strict wire shape)",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "answered",
        "out_of_scope"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "image_descriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image_ref": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "image_ref",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "assessment": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "replace",
            "unchanged"
          ]
        },
        "outcome": {
          "enum": [
            "",
            "collecting_information",
            "self_service",
            "professional_required"
          ]
        },
        "problem_title": {
          "type": "string"
        },
        "problem_description": {
          "type": "string"
        },
        "problem_category_name": {
          "type": "string"
        },
        "selected_image_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 3
        }
      },
      "required": [
        "action",
        "outcome",
        "problem_title",
        "problem_description",
        "problem_category_name",
        "selected_image_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "unchanged"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": ""
              },
              "problem_title": {
                "const": ""
              },
              "problem_description": {
                "const": ""
              },
              "problem_category_name": {
                "const": ""
              },
              "selected_image_refs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "replace"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "collecting_information",
                  "self_service",
                  "professional_required"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "collecting_information"
              }
            }
          },
          "then": {
            "properties": {
              "problem_title": {
                "const": ""
              },
              "problem_description": {
                "const": ""
              },
              "problem_category_name": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "self_service",
                  "professional_required"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "problem_title": {
                "type": "string",
                "minLength": 1
              },
              "problem_description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "professional_required"
              }
            }
          },
          "then": {
            "properties": {
              "problem_category_name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "status",
    "title",
    "content",
    "image_descriptions",
    "assessment"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "out_of_scope"
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "action": {
                "const": "unchanged"
              }
            }
          }
        }
      }
    }
  ]
}
