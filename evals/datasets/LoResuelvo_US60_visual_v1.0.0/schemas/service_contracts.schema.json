{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoResuelvo service contract specification",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CT-[0-9]{2}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    },
    "origin": {
      "const": "synthetic_contract_fixture"
    },
    "execution_scope": {
      "const": "service_or_harness"
    },
    "review_status": {
      "const": "finalized"
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "target",
    "input",
    "expected",
    "origin",
    "execution_scope",
    "review_status"
  ],
  "additionalProperties": false
}
