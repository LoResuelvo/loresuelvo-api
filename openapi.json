{
    "openapi": "3.0.3",
    "info": {
        "title": "LoResuelvo API",
        "description": "OpenAPI documentation for the LoResuelvo HTTP API as implemented by the current Gin routes.",
        "version": "0.1.0",
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/license/mit"
        }
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Local development server"
        }
    ],
    "tags": [
        {
            "name": "Health",
            "description": "Service availability endpoints."
        },
        {
            "name": "Categories",
            "description": "Service category management endpoints."
        },
        {
            "name": "Consumers",
            "description": "Consumer account registration endpoints."
        },
        {
            "name": "Providers",
            "description": "Provider account registration endpoints."
        },
        {
            "name": "Users",
            "description": "Authenticated user session endpoints."
        }
    ],
    "security": [],
    "paths": {
        "/": {
            "get": {
                "tags": [
                    "Health"
                ],
                "operationId": "getHealthGreeting",
                "summary": "Get service greeting",
                "description": "Returns the plain-text welcome response used as a basic health check.",
                "responses": {
                    "200": {
                        "description": "The API is running.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Hello World"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/categories": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "operationId": "listCategories",
                "summary": "List service categories",
                "description": "Returns all registered categories. Each list item contains only id and name; normalized_name is intentionally omitted by the current handler.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Categories returned successfully. The array may be empty.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryListItem"
                                    }
                                },
                                "examples": {
                                    "withCategories": {
                                        "value": [
                                            {
                                                "id": 1,
                                                "name": "Electricidad"
                                            },
                                            {
                                                "id": 2,
                                                "name": "Plomería"
                                            }
                                        ]
                                    },
                                    "empty": {
                                        "value": []
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication failed or the authenticated user id could not be obtained from the request context.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthErrorResponse"
                                },
                                "examples": {
                                    "invalidToken": {
                                        "summary": "Missing or invalid Bearer token",
                                        "value": {
                                            "error": "invalid_token",
                                            "message": "Failed to validate JWT."
                                        }
                                    },
                                    "missingClaims": {
                                        "summary": "JWT claims not available after validation",
                                        "value": {
                                            "error": "missing claims"
                                        }
                                    },
                                    "missingUserId": {
                                        "summary": "Subject claim is missing or empty",
                                        "value": {
                                            "error": "missing user id"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "The category repository returned an unexpected error.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "repositoryError": {
                                        "value": {
                                            "error": "database error"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Categories"
                ],
                "operationId": "createCategory",
                "summary": "Create a service category",
                "description": "Creates a category using the provided name. The domain trims surrounding whitespace and stores a lowercase normalized_name for duplicate checks. Unknown JSON properties are ignored by the current handler.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateCategoryRequest"
                            },
                            "examples": {
                                "validCategory": {
                                    "summary": "Valid category creation",
                                    "value": {
                                        "name": "Plomería"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Category created successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Category"
                                },
                                "examples": {
                                    "created": {
                                        "value": {
                                            "id": 1,
                                            "name": "Plomería",
                                            "normalized_name": "plomería"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request body is not valid JSON, cannot be bound to the expected payload, or the category name is empty after trimming.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "nameRequired": {
                                        "value": {
                                            "error": "Category name is required"
                                        }
                                    },
                                    "invalidJson": {
                                        "summary": "Invalid JSON body",
                                        "value": {
                                            "error": "invalid character '}' looking for beginning of object key string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication failed or the authenticated user id could not be obtained from the request context.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthErrorResponse"
                                },
                                "examples": {
                                    "invalidToken": {
                                        "summary": "Missing or invalid Bearer token",
                                        "value": {
                                            "error": "invalid_token",
                                            "message": "Failed to validate JWT."
                                        }
                                    },
                                    "missingClaims": {
                                        "summary": "JWT claims not available after validation",
                                        "value": {
                                            "error": "missing claims"
                                        }
                                    },
                                    "missingUserId": {
                                        "summary": "Subject claim is missing or empty",
                                        "value": {
                                            "error": "missing user id"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "A category with the same normalized name already exists.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "categoryAlreadyExists": {
                                        "value": {
                                            "error": "Category already exists"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/consumers": {
            "post": {
                "tags": [
                    "Consumers"
                ],
                "operationId": "registerConsumer",
                "summary": "Register the authenticated user as a consumer",
                "description": "Creates a consumer account for the authenticated Auth0 subject. The Auth0 subject is taken from the Bearer JWT and persisted as the user's auth identifier. Unknown JSON properties are ignored by the current handler.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterConsumerRequest"
                            },
                            "examples": {
                                "validConsumer": {
                                    "summary": "Valid consumer registration",
                                    "value": {
                                        "email": "ana@example.com",
                                        "name": "Ana Perez",
                                        "surname": "Mamani Tipula"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Consumer account registered successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MessageResponse"
                                },
                                "examples": {
                                    "registered": {
                                        "value": {
                                            "message": "cuenta registrada exitosamente"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request body is not valid JSON, cannot be bound to the expected payload, or contains an invalid email format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "invalidEmail": {
                                        "summary": "Invalid email format",
                                        "value": {
                                            "error": "Invalid email format"
                                        }
                                    },
                                    "invalidJson": {
                                        "summary": "Invalid JSON body",
                                        "value": {
                                            "error": "invalid character '}' looking for beginning of object key string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication failed or the authenticated user id could not be obtained from the request context.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthErrorResponse"
                                },
                                "examples": {
                                    "invalidToken": {
                                        "summary": "Missing or invalid Bearer token",
                                        "value": {
                                            "error": "invalid_token",
                                            "message": "Failed to validate JWT."
                                        }
                                    },
                                    "missingClaims": {
                                        "summary": "JWT claims not available after validation",
                                        "value": {
                                            "error": "missing claims"
                                        }
                                    },
                                    "missingUserId": {
                                        "summary": "Subject claim is missing or empty",
                                        "value": {
                                            "error": "missing user id"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "A user with the same email already exists.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "emailAlreadyRegistered": {
                                        "value": {
                                            "error": "Email is already registered"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/providers": {
            "post": {
                "tags": [
                    "Providers"
                ],
                "operationId": "registerProvider",
                "summary": "Register the authenticated user as a provider",
                "description": "Creates a provider account for the authenticated Auth0 subject. The Auth0 subject is taken from the Bearer JWT and persisted as the user auth identifier. The current implementation consumes email, name, surname, and category_id; coverage_zone is accepted by JSON binding but is not passed to the provider service or persisted.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterProviderRequest"
                            },
                            "examples": {
                                "validProvider": {
                                    "summary": "Valid provider registration",
                                    "value": {
                                        "email": "prestador@example.com",
                                        "name": "Juan",
                                        "surname": "Pérez",
                                        "category_id": 1,
                                        "coverage_zone": [
                                            "Zona Norte"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Provider account registered successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MessageResponse"
                                },
                                "examples": {
                                    "registered": {
                                        "value": {
                                            "message": "cuenta registrada exitosamente"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request body is not valid JSON, cannot be bound to the expected payload, contains an invalid email format, omits category_id, or references a category that does not exist.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "invalidEmail": {
                                        "summary": "Invalid email format",
                                        "value": {
                                            "error": "Invalid email format"
                                        }
                                    },
                                    "invalidJson": {
                                        "summary": "Invalid JSON body",
                                        "value": {
                                            "error": "invalid character '}' looking for beginning of object key string"
                                        }
                                    },
                                    "categoryRequired": {
                                        "summary": "Missing or zero category id",
                                        "value": {
                                            "error": "Category id is required"
                                        }
                                    },
                                    "categoryNotFound": {
                                        "summary": "Category id does not exist",
                                        "value": {
                                            "error": "Category does not exist"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication failed or the authenticated user id could not be obtained from the request context.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthErrorResponse"
                                },
                                "examples": {
                                    "invalidToken": {
                                        "summary": "Missing or invalid Bearer token",
                                        "value": {
                                            "error": "invalid_token",
                                            "message": "Failed to validate JWT."
                                        }
                                    },
                                    "missingClaims": {
                                        "summary": "JWT claims not available after validation",
                                        "value": {
                                            "error": "missing claims"
                                        }
                                    },
                                    "missingUserId": {
                                        "summary": "Subject claim is missing or empty",
                                        "value": {
                                            "error": "missing user id"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "A user with the same email already exists.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "emailAlreadyRegistered": {
                                        "value": {
                                            "error": "Email is already registered"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/me": {
            "get": {
                "tags": [
                    "Users"
                ],
                "operationId": "getCurrentUser",
                "summary": "Get the authenticated user",
                "description": "Returns the user associated with the Auth0 subject contained in the Bearer JWT. The response property names currently match the exported Go struct fields because the User struct has no json tags.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Authenticated user found.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                },
                                "examples": {
                                    "consumer": {
                                        "summary": "Consumer user",
                                        "value": {
                                            "AuthID": "auth0|login-consumer-test",
                                            "Name": "Consumer",
                                            "Surname": "Login",
                                            "Email": "login-consumer@example.com",
                                            "Role": "consumer"
                                        }
                                    },
                                    "provider": {
                                        "summary": "Provider user",
                                        "value": {
                                            "AuthID": "auth0|login-provider-test",
                                            "Name": "Provider",
                                            "Surname": "Login",
                                            "Email": "login-provider@example.com",
                                            "Role": "provider"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication failed or the authenticated user id could not be obtained from the request context.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthErrorResponse"
                                },
                                "examples": {
                                    "invalidToken": {
                                        "summary": "Missing or invalid Bearer token",
                                        "value": {
                                            "error": "invalid_token",
                                            "message": "Failed to validate JWT."
                                        }
                                    },
                                    "missingClaims": {
                                        "summary": "JWT claims not available after validation",
                                        "value": {
                                            "error": "missing claims"
                                        }
                                    },
                                    "missingUserId": {
                                        "summary": "Subject claim is missing or empty",
                                        "value": {
                                            "error": "missing user id"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No persisted user exists for the authenticated Auth0 subject.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "userNotFound": {
                                        "value": {
                                            "error": "User was not found"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Auth0-issued JWT. The API uses the token subject claim as the internal auth identifier."
            }
        },
        "schemas": {
            "RegisterConsumerRequest": {
                "type": "object",
                "description": "Payload accepted by POST /consumers. The implementation trims surrounding whitespace from all string fields before validation/persistence.",
                "required": [
                    "email"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "Consumer email. Must match the server email validation regex.",
                        "example": "ana@example.com"
                    },
                    "name": {
                        "type": "string",
                        "description": "Consumer given name or display name. The current implementation persists the value but does not enforce non-empty validation.",
                        "example": "Ana Perez"
                    },
                    "surname": {
                        "type": "string",
                        "description": "Consumer surname. The current implementation persists the value but does not enforce non-empty validation.",
                        "example": "Mamani Tipula"
                    }
                }
            },
            "RegisterProviderRequest": {
                "type": "object",
                "description": "Payload accepted by POST /providers. The implementation trims surrounding whitespace from email, name, and surname before validation/persistence. category_id is required by the domain service. coverage_zone is currently accepted by the request struct but ignored by the service.",
                "required": [
                    "email",
                    "category_id"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "Provider email. Must match the server email validation regex.",
                        "example": "prestador@example.com"
                    },
                    "name": {
                        "type": "string",
                        "description": "Provider given name. The current implementation persists the value but does not enforce non-empty validation.",
                        "example": "Juan"
                    },
                    "surname": {
                        "type": "string",
                        "description": "Provider surname. The current implementation persists the value but does not enforce non-empty validation.",
                        "example": "Pérez"
                    },
                    "coverage_zone": {
                        "type": "array",
                        "description": "Accepted by JSON binding for backwards compatibility, but the current handler does not pass this value to the provider service and it is not persisted.",
                        "items": {
                            "type": "string",
                            "example": "Zona Norte"
                        },
                        "example": [
                            "Zona Norte"
                        ],
                        "deprecated": true
                    },
                    "category_id": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Existing category identifier for the provider. Missing or zero values return \"Category id is required\"; unknown ids return \"Category does not exist\".",
                        "example": 1
                    }
                }
            },
            "MessageResponse": {
                "type": "object",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "cuenta registrada exitosamente"
                    }
                },
                "additionalProperties": false
            },
            "ErrorResponse": {
                "type": "object",
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "type": "string",
                        "example": "Invalid email format"
                    }
                },
                "additionalProperties": false
            },
            "AuthErrorResponse": {
                "type": "object",
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "type": "string",
                        "enum": [
                            "invalid_token",
                            "missing claims",
                            "missing user id"
                        ],
                        "example": "invalid_token"
                    },
                    "message": {
                        "type": "string",
                        "description": "Present in JWT middleware validation failures.",
                        "example": "Failed to validate JWT."
                    }
                },
                "additionalProperties": false
            },
            "User": {
                "type": "object",
                "description": "Authenticated user response. Field names are currently capitalized because they are serialized from exported Go struct fields without json tags.",
                "required": [
                    "AuthID",
                    "Name",
                    "Surname",
                    "Email",
                    "Role"
                ],
                "properties": {
                    "AuthID": {
                        "type": "string",
                        "description": "Auth0 subject persisted for this user.",
                        "example": "auth0|login-consumer-test"
                    },
                    "Name": {
                        "type": "string",
                        "example": "Consumer"
                    },
                    "Surname": {
                        "type": "string",
                        "example": "Login"
                    },
                    "Email": {
                        "type": "string",
                        "format": "email",
                        "example": "login-consumer@example.com"
                    },
                    "Role": {
                        "type": "string",
                        "description": "Persisted user role.",
                        "enum": [
                            "consumer",
                            "provider"
                        ],
                        "example": "consumer"
                    }
                },
                "additionalProperties": false
            },
            "CreateCategoryRequest": {
                "type": "object",
                "description": "Payload accepted by POST /categories. The implementation trims surrounding whitespace from name before validation and duplicate checks.",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Category display name. Must be non-empty after trimming. Duplicate detection uses a lowercase normalized version.",
                        "example": "Plomería"
                    }
                }
            },
            "Category": {
                "type": "object",
                "description": "Category creation response.",
                "required": [
                    "id",
                    "name",
                    "normalized_name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Plomería"
                    },
                    "normalized_name": {
                        "type": "string",
                        "description": "Lowercase category name used by the server for duplicate checks.",
                        "example": "plomería"
                    }
                },
                "additionalProperties": false
            },
            "CategoryListItem": {
                "type": "object",
                "description": "Category list item returned by GET /categories. normalized_name is not included in list responses.",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Plomería"
                    }
                },
                "additionalProperties": false
            }
        }
    }
}
